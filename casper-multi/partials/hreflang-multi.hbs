<script>
(function(){
    var LANGS = ["en", "ko"];       // supported languages; extend here
    var DEFAULT_LANG = "en";        // served without a URL prefix

    var tagNames = [{{#foreach tags visibility="all"}}"{{name}}"{{#unless @last}},{{/unless}}{{/foreach}}];
    var isMulti = tagNames.indexOf("#multi") !== -1;

    var lang = null;
    LANGS.forEach(function(l) {
        if (tagNames.indexOf("#" + l) !== -1) lang = l;
    });

    var slug = "{{slug}}";
    var siteUrl = "{{@site.url}}";
    var suffixPattern = new RegExp("-(" + LANGS.join("|") + ")$");
    var stem = slug.replace(suffixPattern, "");

    function buildUrl(l) {
        var prefix = (l === DEFAULT_LANG) ? "" : "/" + l;
        return siteUrl + prefix + "/" + stem + "-" + l + "/";
    }

    var urls = {};
    if (isMulti && lang) {
        LANGS.forEach(function(l) {
            urls[l] = buildUrl(l);
        });
    }

    window.casperMultiLanguageContext = {
        contentType: "{{contentType}}",
        isMulti: isMulti,
        currentLanguage: lang,
        urls: urls
    };

    if (!isMulti || !lang) return;

    var html = "";
    LANGS.forEach(function(l) {
        html += '<link rel="alternate" hreflang="' + l + '" href="' + urls[l] + '"/>';
    });
    html += '<link rel="alternate" hreflang="x-default" href="' + urls[DEFAULT_LANG] + '"/>';

    document.head.insertAdjacentHTML("beforeend", html);
})();
</script>
